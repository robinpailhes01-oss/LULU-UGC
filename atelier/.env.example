# Atelier — variables d'environnement
#
# En local, AUCUNE variable n'est nécessaire : base PGlite et fichiers sur disque (.atelier-data/),
# accès libre sans mot de passe. Copiez ce fichier en .env.local et ne remplissez que ce dont
# vous avez besoin. En ligne (Vercel), saisissez les mêmes variables dans le projet « atelier ».
#
# Les comptes Supabase, Zernio et Cloudflare R2 sont DÉDIÉS À JUNE : l'Atelier ne s'y branche
# que par ces variables, jamais par une connexion enregistrée ailleurs sur la machine.
# Ne committez jamais de vraies valeurs (.env.local est ignoré par git).

# --- Accès -----------------------------------------------------------------------------------
# Mot de passe partagé de l'équipe. Obligatoire en production (sinon l'Atelier refuse de s'ouvrir).
ATELIER_PASSWORD=
# Secret de signature des sessions et des liens de fichiers locaux (long et aléatoire :
# `openssl rand -base64 32`). Par défaut : ATELIER_PASSWORD.
ATELIER_SECRET=
# Prénoms proposés à la connexion (ils signent le journal d'activité).
ATELIER_TEAM=Ludivine,Robin
# Adresse publique de l'Atelier (liens, webhook Zernio). En local : http://localhost:3100
ATELIER_APP_URL=http://localhost:3100
# Fuseau horaire des programmations.
ATELIER_TIMEZONE=Europe/Paris

# --- Base de données (Supabase de June) ------------------------------------------------------
# Vide = PGlite local. Sinon la chaîne du pooler de TRANSACTIONS (port 6543) :
# Supabase → Project Settings → Database → Connection string → Transaction pooler.
# Les tables sont créées automatiquement dans le schéma « atelier » au premier accès.
DATABASE_URL=

# --- Stockage des fichiers (Cloudflare R2 de June, ou tout S3 compatible) --------------------
# Vide = disque local. Il faut le bucket, les deux clés et R2_ACCOUNT_ID (ou S3_ENDPOINT).
R2_ACCOUNT_ID=
# S3_ENDPOINT=https://<compte>.r2.cloudflarestorage.com   (autre fournisseur S3 : son point d'accès)
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Facultatif : domaine public du bucket (r2.dev ou domaine personnalisé), sinon liens signés.
S3_PUBLIC_BASE_URL=
# Facultatif : région (R2 : auto) et adressage en chemin (MinIO : true).
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=false

# --- Agent Claude ----------------------------------------------------------------------------
# Clé d'API Anthropic : agent, analyse des photos, idées de légendes. Vide = fonctions IA désactivées.
ANTHROPIC_API_KEY=
# Facultatif : modèle utilisé (défaut : claude-opus-5-5).
# ATELIER_MODEL=claude-opus-5-5

# --- Programmation (Zernio de June) ----------------------------------------------------------
# Vide = les publications restent des brouillons locaux.
ZERNIO_API_KEY=
# Secret du webhook : dans Zernio, webhook vers <ATELIER_APP_URL>/api/webhooks/zernio avec ce secret.
ZERNIO_WEBHOOK_SECRET=
# Facultatif : adresse de l'API (défaut : https://zernio.com/api).
# ZERNIO_API_URL=https://zernio.com/api

# --- Rendu vidéo HyperFrames -----------------------------------------------------------------
# local (Chrome + FFmpeg sur la machine, défaut en développement), sandbox (Vercel Sandbox),
# heygen (rendu cloud HeyGen) ou none (défaut en production).
HYPERFRAMES_RENDER=
# Pour heygen :
HEYGEN_API_KEY=
# Pour sandbox :
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# --- Développement ---------------------------------------------------------------------------
# Dossier des données locales (défaut : .atelier-data).
# ATELIER_DATA_DIR=.atelier-data
# Dossier de build Next (pour faire tourner plusieurs copies en parallèle).
# NEXT_DIST_DIR=.next
# Pour `npm run skills:pull` : adresse de l'Atelier en ligne à rapatrier (+ ATELIER_PASSWORD).
# ATELIER_URL=https://atelier.example.com
