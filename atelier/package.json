{
  "name": "june-atelier",
  "version": "0.1.0",
  "private": true,
  "description": "Atelier — médiathèque, retouche, ménage, montage HyperFrames, programmation Zernio et agent Claude pour June Content Studio",
  "scripts": {
    "predev": "node scripts/bundle-skills.mjs",
    "dev": "next dev -p 3100",
    "prebuild": "node scripts/bundle-skills.mjs --strict",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "skills:bundle": "node scripts/bundle-skills.mjs",
    "skills:pull": "node scripts/pull-skills.mjs",
    "db:sql": "node scripts/print-sql.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@aws-sdk/client-s3": "3.1150.0",
    "@aws-sdk/s3-request-presigner": "3.1150.0",
    "@electric-sql/pglite": "0.5.9",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "exifr": "7.1.3",
    "lucide-react": "1.55.0",
    "next": "15.5.27",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.30",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
